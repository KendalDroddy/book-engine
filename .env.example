# SQLAlchemy URL for the canonical local database.
BOOK_ENGINE_DATABASE_URL=sqlite:///./data/book_engine.db
BOOK_ENGINE_SQL_ECHO=false

# Optional contact address for Open Library's identifying User-Agent.
BOOK_ENGINE_OPENLIBRARY_CONTACT_EMAIL=

# Optional: required only for model-backed recommendation validation.
BOOK_ENGINE_OPENAI_API_KEY=
BOOK_ENGINE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOOK_ENGINE_OPENAI_EMBEDDING_DIMENSIONS=1536
BOOK_ENGINE_OPENAI_TIMEOUT_SECONDS=30
